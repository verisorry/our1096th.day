# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Contact information for the person you're tracking messages with
HIS_PHONE=+1234567890
HIS_EMAIL=email@example.com

# Names for display in the application
HIS_NAME=Name
YOUR_NAME=YourName

# Same names again, exposed to the browser for the hover card
NEXT_PUBLIC_HIS_NAME=Name
NEXT_PUBLIC_YOUR_NAME=YourName

# Password for the site. Inlined into the client bundle, so this is ceremony
# rather than real security - don't reuse a password you care about
NEXT_PUBLIC_SITE_PASSWORD=change-me

ANNIVERSARY=YYYY-MM-DD
